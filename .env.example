# ============================================================
#  .env.example — nusxa oling:  cp .env.example .env
#  .env fayli hech qachon git'ga qo'shilmaydi.
# ============================================================

# --- Sayt manzili (MAJBURIY). Oxirida "/" bo'lmasin. ---
# canonical, sitemap, Open Graph uchun. BUILD paytida o'qiladi —
# o'zgartirsangiz, "npm run build" ni qayta bajaring.
NEXT_PUBLIC_SITE_URL=https://kotyol-usta.uz

# --- Server porti ---
PORT=3000
HOSTNAME=127.0.0.1

# --- Supabase ---
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Telegram (faqat serverda, brauzerga chiqmaydi) ---
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
# Arizalar keladigan chat/guruh ID. Bir nechta bo'lsa vergul bilan: 123456789,-1001234567890
TELEGRAM_CHAT_ID=
# Ixtiyoriy: Telegram API uchun proksi/mirror manzili (odatda bo'sh qoldiring)
TELEGRAM_API_URL=

# --- Zaxira: arizalar fayli (JSON Lines) ---
# Bo'sh = <loyiha>/data/leads.jsonl.  "off" = o'chirish (tavsiya etilmaydi)
LEADS_LOG_FILE=

# IP xeshlash uchun tasodifiy satr (spamga qarshi, IP ochiq saqlanmaydi)
IP_HASH_SALT=change-me-to-random-string

# --- Analitika (ixtiyoriy). Bo'sh = hech narsa yuklanmaydi ---
# GTM bo'lsa GA ni GTM ichida sozlang (ikkalasi birga yuklanmaydi)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# --- Qidiruv tizimlarida tasdiqlash (meta teg) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
